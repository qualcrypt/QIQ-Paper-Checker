# Copy to .env and fill in. Server-side only; never sent to the browser.
# Get keys at https://console.groq.com/keys
#
# One key is enough. Add more to survive the free tier's per-minute token limit
# during a long marking run — the proxy fails over to the next key on 429.
GROQ_API_KEY=
GROQ_API_KEY_2=

# Equivalent, if you prefer a single line:
# GROQ_API_KEYS=gsk_first,gsk_second
