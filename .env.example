# Copy to .env and fill in. Server-side only; never sent to the browser.
# Get keys at https://console.groq.com/keys
#
# One key is enough. Add more to survive the free tier's per-minute token limit
# during a long marking run — the proxy fails over to the next key on 429.
GROQ_API_KEY=
GROQ_API_KEY_2=

# Equivalent, if you prefer a single line:
# GROQ_API_KEYS=gsk_first,gsk_second

# --- Production server (server.js) -------------------------------------------
# PORT=3000                     # listen port; Hostinger/Nginx proxy to this
# PROXY_RATE_LIMIT_PER_MIN=120  # per-IP ceiling on /api/groq
# MAX_BODY_MB=25                # max request body (page images as base64)

# --- Split deployment only (optional) ----------------------------------------
# VITE_API_URL=                 # build-time; backend origin if frontend and
                                # backend are hosted on different origins
